# Frontend network / RPC configuration
# Local devnet example:
# NEXT_PUBLIC_CKB_RPC_URL=http://127.0.0.1:8114
# NEXT_PUBLIC_CKB_NETWORK=devnet
# If your ckb node binary is not in PATH, pass it when starting devnet:
# make devnet-start DEVNET_CKB_BIN=/absolute/path/to/ckb DEVNET_FROM_ADDRESS=<ckt1...>
# Hosted testnet example:
# NEXT_PUBLIC_CKB_RPC_URL=https://testnet.ckb.dev/rpc
# NEXT_PUBLIC_CKB_NETWORK=testnet

NEXT_PUBLIC_CKB_RPC_URL=https://testnet.ckb.dev/rpc
NEXT_PUBLIC_CKB_NETWORK=testnet

# Freight contract reference
NEXT_PUBLIC_FREIGHT_CODE_HASH=0x50257469fedf0fc38ea06f803f289a4a395f802b7cc59a03d00846c9e6e36f43
NEXT_PUBLIC_FREIGHT_HASH_TYPE=type
NEXT_PUBLIC_FREIGHT_OUTPOINT_TX_HASH=0x48c6a734b1ef27cf8f877f800911b1373587d61011269f697cd524d23df64ab5
NEXT_PUBLIC_FREIGHT_OUTPOINT_INDEX=0

# Backend persistence
MONGODB_URI=
MONGODB_DB_NAME=freightonnervos

# Pull polling is opt-in. Webhook push updates work when this is false.
FON_POLLING_ENABLED=false
# Required for authenticated production calls to the poll endpoint when enabled.
# Vercel also supports CRON_SECRET.
FON_POLL_CRON_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/link/callback
GOOGLE_LINK_STATE_SECRET=replace-with-a-long-random-secret

