# Public FON URL and the separately deployed demo URL.
FON_BASE_URL=https://fon.example.com
NEXT_PUBLIC_APP_BASE_URL=https://checkbox-demo.example.com

# Match the FON frontend's network.
NEXT_PUBLIC_CKB_NETWORK=testnet

# Required for durable mounts, participant state, JoyID sessions, and logs.
MONGODB_URI=mongodb://localhost:27017/checkbox-demo
MONGODB_DB_NAME=checkbox-demo

# Existing app registration credential, or set after first local registration.
# Never expose this through NEXT_PUBLIC_*.
FON_REGISTRATION_SECRET=
